{
  "CLIPLoader": {
    "input_order": {
      "required": [
        "clip_name",
        "type"
      ],
      "optional": [
        "device"
      ]
    },
    "clip_name": {
      "required": true,
      "spec": [
        [
          "gemma_3_12B_it_fp4_mixed.safetensors",
          "minimax_music3_text_encoder_pruned_int8_convrot.safetensors",
          "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
          "qwen3vl_8b_fp8_scaled.safetensors",
          "qwen_0.6b_ace15.safetensors",
          "qwen_2.5_vl_7b_fp8_scaled.safetensors",
          "qwen_3_4b.safetensors",
          "qwen_4b_ace15.safetensors",
          "t5-base.safetensors",
          "umt5_xxl_fp16.safetensors",
          "umt5_xxl_fp8_e4m3fn_scaled.safetensors"
        ]
      ]
    },
    "type": {
      "required": true,
      "spec": [
        [
          "stable_diffusion",
          "stable_cascade",
          "sd3",
          "stable_audio",
          "mochi",
          "ltxv",
          "pixart",
          "cosmos",
          "lumina2",
          "wan",
          "hidream",
          "chroma",
          "ace",
          "omnigen2",
          "qwen_image",
          "hunyuan_image",
          "flux2",
          "ovis",
          "longcat_image",
          "cogvideox",
          "lens",
          "pixeldit",
          "ideogram4",
          "boogu",
          "krea2",
          "joyimage",
          "mage",
          "minimax",
          "yue2"
        ]
      ]
    },
    "device": {
      "required": false,
      "spec": [
        [
          "default",
          "cpu"
        ],
        {
          "advanced": true
        }
      ]
    }
  },
  "UNETLoader": {
    "input_order": {
      "required": [
        "unet_name",
        "weight_dtype"
      ]
    },
    "unet_name": {
      "required": true,
      "spec": [
        [
          "Wan21-WanMove_fp8_scaled_e4m3fn_KJ.safetensors",
          "acestep_v1.5_turbo.safetensors",
          "acestep_v1.5_xl_sft_bf16.safetensors",
          "acestep_v1.5_xl_turbo_bf16.safetensors",
          "boogu_image_edit_fp8_scaled.safetensors",
          "boogu_image_turbo_fp8_scaled.safetensors",
          "fastvideo_fasth3_8step_v2_pruned_int8_convrot.safetensors",
          "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
          "minimax_music3_dit_fp16.safetensors",
          "qwen_image_2512_fp8_e4m3fn.safetensors",
          "qwen_image_edit_2509_fp8_e4m3fn.safetensors",
          "qwen_image_layered_bf16.safetensors",
          "wan2.1_vace_1.3B_fp16.safetensors",
          "wan2.1_vace_14B_fp16.safetensors",
          "wan2.2_fun_inpaint_high_noise_14B_fp8_scaled.safetensors",
          "wan2.2_fun_inpaint_low_noise_14B_fp8_scaled.safetensors",
          "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
          "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
          "wan2.2_t2v_high_noise_14B_fp8_scaled.safetensors",
          "wan2.2_t2v_low_noise_14B_fp8_scaled.safetensors",
          "z_image_turbo_bf16.safetensors"
        ]
      ]
    },
    "weight_dtype": {
      "required": true,
      "spec": [
        [
          "default",
          "fp8_e4m3fn",
          "fp8_e4m3fn_fast",
          "fp8_e5m2"
        ],
        {
          "advanced": true
        }
      ]
    }
  },
  "VAELoader": {
    "input_order": {
      "required": [
        "vae_name"
      ]
    },
    "vae_name": {
      "required": true,
      "spec": [
        [
          "ace_1.5_vae.safetensors",
          "ae.safetensors",
          "minimax_h3_audio_vae_fp32.safetensors",
          "minimax_h3_video_vae_fp16.safetensors",
          "minimax_music3_dav.safetensors",
          "qwen_image_layered_vae.safetensors",
          "qwen_image_vae.safetensors",
          "wan_2.1_vae.safetensors",
          "pixel_space"
        ]
      ]
    }
  },
  "CLIPTextEncode": {
    "input_order": {
      "required": [
        "text",
        "clip"
      ]
    },
    "text": {
      "required": true,
      "spec": [
        "STRING",
        {
          "multiline": true,
          "dynamicPrompts": true,
          "tooltip": "The text to be encoded."
        }
      ]
    },
    "clip": {
      "required": true,
      "spec": [
        "CLIP",
        {
          "tooltip": "The CLIP model used for encoding the text."
        }
      ]
    }
  },
  "ConditioningZeroOut": {
    "input_order": {
      "required": [
        "conditioning"
      ]
    },
    "conditioning": {
      "required": true,
      "spec": [
        "CONDITIONING"
      ]
    }
  },
  "EmptySD3LatentImage": {
    "input_order": {
      "required": [
        "width",
        "height",
        "batch_size"
      ]
    },
    "width": {
      "required": true,
      "spec": [
        "INT",
        {
          "default": 1024,
          "min": 16,
          "max": 16384,
          "step": 16
        }
      ]
    },
    "height": {
      "required": true,
      "spec": [
        "INT",
        {
          "default": 1024,
          "min": 16,
          "max": 16384,
          "step": 16
        }
      ]
    },
    "batch_size": {
      "required": true,
      "spec": [
        "INT",
        {
          "default": 1,
          "min": 1,
          "max": 4096
        }
      ]
    }
  },
  "ModelSamplingAuraFlow": {
    "input_order": {
      "required": [
        "model",
        "shift"
      ],
      "optional": [
        "sampling"
      ]
    },
    "model": {
      "required": true,
      "spec": [
        "MODEL"
      ]
    },
    "shift": {
      "required": true,
      "spec": [
        "FLOAT",
        {
          "default": 1.73,
          "min": 0.0,
          "max": 100.0,
          "step": 0.01
        }
      ]
    },
    "sampling": {
      "required": false,
      "spec": [
        [
          "flow",
          "img_to_img_velocity"
        ],
        {
          "default": "flow",
          "advanced": true
        }
      ]
    }
  },
  "KSampler": {
    "input_order": {
      "required": [
        "model",
        "seed",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler",
        "positive",
        "negative",
        "latent_image",
        "denoise"
      ]
    },
    "model": {
      "required": true,
      "spec": [
        "MODEL",
        {
          "tooltip": "The model used for denoising the input latent."
        }
      ]
    },
    "seed": {
      "required": true,
      "spec": [
        "INT",
        {
          "default": 0,
          "min": 0,
          "max": 18446744073709551615,
          "control_after_generate": true,
          "tooltip": "The random seed used for creating the noise."
        }
      ]
    },
    "steps": {
      "required": true,
      "spec": [
        "INT",
        {
          "default": 20,
          "min": 1,
          "max": 10000,
          "tooltip": "The number of steps used in the denoising process."
        }
      ]
    },
    "cfg": {
      "required": true,
      "spec": [
        "FLOAT",
        {
          "default": 8.0,
          "min": 0.0,
          "max": 100.0,
          "step": 0.1,
          "round": 0.01,
          "tooltip": "The Classifier-Free Guidance scale balances creativity and adherence to the prompt. Higher values result in images more closely matching the prompt however too high values will negatively impact quality."
        }
      ]
    },
    "sampler_name": {
      "required": true,
      "spec": [
        [
          "euler",
          "euler_cfg_pp",
          "euler_ancestral",
          "euler_ancestral_cfg_pp",
          "heun",
          "heunpp2",
          "exp_heun_2_x0",
          "exp_heun_2_x0_sde",
          "dpm_2",
          "dpm_2_ancestral",
          "lms",
          "dpm_fast",
          "dpm_adaptive",
          "dpmpp_2s_ancestral",
          "dpmpp_2s_ancestral_cfg_pp",
          "dpmpp_sde",
          "dpmpp_sde_gpu",
          "dpmpp_2m",
          "dpmpp_2m_cfg_pp",
          "dpmpp_2m_sde",
          "dpmpp_2m_sde_gpu",
          "dpmpp_2m_sde_heun",
          "dpmpp_2m_sde_heun_gpu",
          "dpmpp_3m_sde",
          "dpmpp_3m_sde_gpu",
          "ddpm",
          "lcm",
          "ipndm",
          "ipndm_v",
          "deis",
          "cfgpp_ud10_ab",
          "res_multistep",
          "res_multistep_cfg_pp",
          "res_multistep_ancestral",
          "res_multistep_ancestral_cfg_pp",
          "gradient_estimation",
          "gradient_estimation_cfg_pp",
          "er_sde",
          "seeds_2",
          "seeds_3",
          "sa_solver",
          "sa_solver_pece",
          "ddim",
          "uni_pc",
          "uni_pc_bh2"
        ],
        {
          "tooltip": "The algorithm used when sampling, this can affect the quality, speed, and style of the generated output."
        }
      ]
    },
    "scheduler": {
      "required": true,
      "spec": [
        [
          "simple",
          "sgm_uniform",
          "karras",
          "exponential",
          "ddim_uniform",
          "beta",
          "normal",
          "linear_quadratic",
          "kl_optimal"
        ],
        {
          "tooltip": "The scheduler controls how noise is gradually removed to form the image."
        }
      ]
    },
    "positive": {
      "required": true,
      "spec": [
        "CONDITIONING",
        {
          "tooltip": "The conditioning describing the attributes you want to include in the image."
        }
      ]
    },
    "negative": {
      "required": true,
      "spec": [
        "CONDITIONING",
        {
          "tooltip": "The conditioning describing the attributes you want to exclude from the image."
        }
      ]
    },
    "latent_image": {
      "required": true,
      "spec": [
        "LATENT",
        {
          "tooltip": "The latent image to denoise."
        }
      ]
    },
    "denoise": {
      "required": true,
      "spec": [
        "FLOAT",
        {
          "default": 1.0,
          "min": 0.0,
          "max": 1.0,
          "step": 0.01,
          "tooltip": "The amount of denoising applied, lower values will maintain the structure of the initial image allowing for image to image sampling."
        }
      ]
    }
  },
  "VAEDecode": {
    "input_order": {
      "required": [
        "samples",
        "vae"
      ]
    },
    "samples": {
      "required": true,
      "spec": [
        "LATENT",
        {
          "tooltip": "The latent to be decoded."
        }
      ]
    },
    "vae": {
      "required": true,
      "spec": [
        "VAE",
        {
          "tooltip": "The VAE model used for decoding the latent."
        }
      ]
    }
  },
  "SaveImage": {
    "input_order": {
      "required": [
        "images",
        "filename_prefix"
      ],
      "hidden": [
        "prompt",
        "extra_pnginfo"
      ]
    },
    "images": {
      "required": true,
      "spec": [
        "IMAGE",
        {
          "tooltip": "The images to save."
        }
      ]
    },
    "filename_prefix": {
      "required": true,
      "spec": [
        "STRING",
        {
          "default": "ComfyUI",
          "tooltip": "The prefix for the file to save. This may include formatting information such as %date:yyyy-MM-dd% or %Empty Latent Image.width% to include values from nodes."
        }
      ]
    }
  }
}
