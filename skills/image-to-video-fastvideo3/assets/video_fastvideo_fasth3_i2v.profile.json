      "aliases": [
        "attn_backend",
        "attention_backend"
      ]
    },
    "duration": {
      "interface": "value_1",
      "aliases": [
        "seconds",
        "duration_seconds"
      ]
    },
    "megapixels": {
      "node": "ImageScaleToTotalPixels",
      "field": "megapixels",
      "aliases": [
